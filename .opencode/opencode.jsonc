{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  // The visual rules live in packages/desktop/AGENTS.md, but almost all the UI we style is in
  // packages/app and packages/ui. Directory-walked AGENTS.md discovery would only pick them up when working
  // under packages/desktop, so register the file as a project instruction instead.
  "instructions": ["packages/desktop/AGENTS.md"],
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
